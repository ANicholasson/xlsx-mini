{
  "name": "xlsx-mini",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-dependency .xlsx writer for TypeScript that runs everywhere.",
  "keywords": [
    "excel",
    "export",
    "spreadsheet",
    "typescript",
    "xlsx",
    "zero-dependency"
  ],
  "homepage": "https://github.com/ANicholasson/xlsx-mini#readme",
  "bugs": "https://github.com/ANicholasson/xlsx-mini/issues",
  "license": "MIT",
  "author": "Aron Nicholasson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANicholasson/xlsx-mini.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "vp config --hooks --no-agent",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "depcruise src test",
    "knip": "knip",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "verify": "vp check && pnpm run typecheck && pnpm run lint:boundaries && pnpm run knip && pnpm run test:coverage",
    "fixtures:update": "UPDATE_FIXTURES=1 vp test run test/golden.test.ts"
  },
  "devDependencies": {
    "@swc/core": "^1.16.21",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.2",
    "knip": "6.44.1",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": "^20.12.0 || >=22"
  },
  "packageManager": "pnpm@12.16.1"
}
