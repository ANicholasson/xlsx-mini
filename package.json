{
  "name": "xlsx-mini",
  "version": "0.4.0",
  "description": "Zero-dependency .xlsx writer for TypeScript that runs everywhere.",
  "keywords": [
    "excel",
    "export",
    "spreadsheet",
    "typescript",
    "xlsx",
    "zero-dependency"
  ],
  "homepage": "https://github.com/ANicholasson/xlsx-mini#readme",
  "bugs": "https://github.com/ANicholasson/xlsx-mini/issues",
  "license": "MIT",
  "author": "Aron Nicholasson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANicholasson/xlsx-mini.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "vp config --hooks --no-agent",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "depcruise src test bench",
    "knip": "knip",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "bench": "pnpm run build && node bench/run.ts",
    "bench:all": "pnpm run build && node bench/run.ts --json bench/results/node.json && bun bench/run.ts --json bench/results/bun.json && deno run --allow-all --no-lock bench/run.ts --json bench/results/deno.json",
    "bench:report": "node bench/report.ts --head bench/results --out bench/results/report.md",
    "bench:memory": "pnpm run build && node bench/memory.ts",
    "check:package": "pnpm run build && publint --strict && attw --pack . --profile esm-only",
    "verify": "vp check && pnpm run typecheck && pnpm run lint:boundaries && pnpm run knip && pnpm run test:coverage && pnpm run check:package",
    "fixtures:update": "UPDATE_FIXTURES=1 vp test run test/golden.test.ts",
    "validate": "XLSX_MINI_VALIDATE=1 vp test run test/validate",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@edge-runtime/vm": "5.0.0",
    "@swc/core": "^1.16.21",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "bun": "1.4.4",
    "deno": "2.9.6",
    "dependency-cruiser": "18.7.2",
    "fast-check": "^4.10.2",
    "knip": "6.44.1",
    "miniflare": "4.20260730.0",
    "publint": "0.3.25",
    "rolldown": "1.3.0",
    "typescript": "7.0.2",
    "vite-plus": "1.5.0"
  },
  "engines": {
    "node": "^20.12.0 || >=22"
  },
  "packageManager": "pnpm@12.16.1"
}
