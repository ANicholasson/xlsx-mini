{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/browser.ts",
    "src/**/tests/**/*.test.ts",
    "test/**/*.test.ts",
    "bench/**/*.bench.ts",
  ],
  "project": ["src/**/*.ts", "test/**/*.ts", "bench/**/*.ts"],
  // dependency-cruiser loads @swc/core at runtime when `parser: "swc"` is set in
  // .dependency-cruiser.cjs; no import of it exists for knip to see.
  // The runtime matrix spawns bun and deno from node_modules/.bin; no import exists for knip to see.
  "ignoreDependencies": ["@swc/core", "bun", "deno"],
}
